DISCORD_TOKEN=your_bot_token_here

# Optional. yt-dlp needs Node.js to extract YouTube audio.
# Leave unset if `node` is already on your PATH.
# Windows example: C:\Program Files\nodejs\node.exe
# NODE_PATH=

# Optional. Leave unset if `ffmpeg` is on PATH; otherwise a bundled binary is used.
# FFMPEG_PATH=
